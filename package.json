{
    "name": "xxdl-nuxt-admin",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "Monorepo: xxdl-admin-core (publishable Nuxt layer) + demo host app",
    "packageManager": "pnpm@10.30.2",
    "scripts": {
        "dev": "pnpm --filter xxdl-nuxt-admin-demo dev",
        "dev:demo": "pnpm --filter xxdl-nuxt-admin-demo dev",
        "dev:playground": "pnpm --filter xxdl-admin-playground dev",
        "build": "pnpm --filter xxdl-nuxt-admin-demo build",
        "build:playground": "pnpm --filter xxdl-admin-playground build",
        "generate": "pnpm --filter xxdl-nuxt-admin-demo generate",
        "preview": "pnpm --filter xxdl-nuxt-admin-demo preview",
        "typecheck": "pnpm -r --no-bail typecheck",
        "check:layers": "node scripts/check-layers.mjs",
        "db:push": "pnpm --filter xxdl-admin-core db:push",
        "db:pull": "pnpm --filter xxdl-admin-core db:pull",
        "db:generate": "pnpm --filter xxdl-admin-core db:generate",
        "seed:admin": "pnpm --filter xxdl-admin-core seed:admin"
    },
    "devDependencies": {
        "tsx": "4.23.15",
        "typescript": "5.7.3"
    }
}
