# ==================================
# 数据库配置
# ==================================
# MySQL 数据库连接 URL
DB_HOST=localhost
DB_DATABASE=nuxt_admin
DB_USER=root
DB_PASSWORD=root

# 应用名称
NUXT_PUBLIC_APP_NAME=Nuxt Admin System

# ==================================
# 环境配置
# ==================================
# 运行环境: development | production
NODE_ENV=development


# ==================================
# Session 配置
# ==================================
# Session 密钥 (请务必修改为随机字符串)
# 生产环境建议使用至少 32 位的随机字符串
NUXT_SESSION_PASSWORD=replace-with-at-least-32-random-characters

# Admin seed account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-before-seeding
ADMIN_EMAIL=admin@example.com

# ==================================
# 其他配置
# ==================================
# 是否启用日志
ENABLE_LOGGING=true

# 日志级别: debug | info | warn | error
LOG_LEVEL=info
